{
  "name": "@opencode-ai/workflow-engine",
  "version": "0.1.0",
  "description": "Deterministic JS script orchestration engine for multi-agent workflows. Ported from claude-code-best.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
